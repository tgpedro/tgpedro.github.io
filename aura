                banner: "https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&q=80&w=1600",
                bio: "Ícone pop global britânica-albanesa, referência em dance-pop futurista e visuais sofisticados.",
                desc: "Ensaio fotográfico exclusivo para edição de moda internacional.",
                tags: ["Vogue", "Fashion", "Editorial", "DuaLipa"]
            }
        ];

        // Top Lançamentos da Semana Data
        const releasesData = [
            {
                title: "Hurry Up Tomorrow (Album)",
                artist: "The Weeknd",
                type: "Álbum Completo • 14 Faixas",
                date: "Lançado esta semana",
                image: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&q=80&w=800",
                streams: "48.2M streams no dia de estreia",
                linkText: "Ouvir no Spotify / Apple Music"
            },
            {
                title: "Training Season (Remixes EP)",
                artist: "Dua Lipa",
                type: "EP / Club Mixes",
                date: "Lançado há 3 dias",
                image: "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&q=80&w=800",
                streams: "19.5M streams",
                linkText: "Ouvir no Spotify / Apple Music"
            },
            {
                title: "TO JACKSONVILLE (Single & Video)",
                artist: "Travis Scott",
                type: "Single Oficial + 4K MV",
                date: "Lançado há 5 dias",
                image: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&q=80&w=800",
                streams: "31.0M streams",
                linkText: "Assistir Videoclipe"
            }
        ];

        let currentMedia = null;

        // Render Feed (Acervo Geral)
        function renderFeed(data, containerId = 'masonryFeed') {
            const container = document.getElementById(containerId);
            container.innerHTML = '';

            if (data.length === 0) {
                container.innerHTML = `<div class="col-span-full py-16 text-center text-zinc-500">Nenhum item encontrado neste acervo.</div>`;
                return;
            }

            data.forEach(item => {
                const card = document.createElement('div');
                card.className = 'masonry-item group cursor-pointer';
                card.onclick = () => openModal(item);

                card.innerHTML = `
                    <div class="relative rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800/80 transition-all duration-300 group-hover:border-purple-500/50 group-hover:shadow-xl group-hover:shadow-purple-950/30">
                        <!-- Media Image -->
                        <div class="relative overflow-hidden">
                            <img src="${item.image}" alt="${item.title}" class="w-full object-cover transition-transform duration-500 group-hover:scale-105">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-4">
                                <div class="flex justify-between items-center">
                                    <span class="px-3 py-1 rounded-full bg-black/70 backdrop-blur-md text-[11px] font-bold text-purple-300 border border-purple-500/30 uppercase tracking-wider">
                                        ${item.type}
                                    </span>
                                    <span class="p-2 rounded-full bg-purple-600 text-white shadow-lg">
                                        <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
                                    </span>
                                </div>
                                <div class="text-xs text-zinc-300 font-medium">
                                    <span>Clique para ampliar & baixar</span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer Info -->
                        <div class="p-3.5 space-y-1.5">
                            <h3 class="font-bold text-sm text-zinc-100 group-hover:text-purple-400 transition line-clamp-1">${item.title}</h3>
                            <div class="flex items-center justify-between pt-1">
                                <div class="flex items-center gap-2 cursor-pointer" onclick="event.stopPropagation(); openArtistPage('${item.artist}')">
                                    <img src="${item.avatar}" alt="${item.artist}" class="w-5 h-5 rounded-full object-cover">
                                    <span class="text-xs text-zinc-400 hover:text-white transition font-medium">${item.artist}</span>
                                </div>
                                <span class="text-[10px] text-zinc-500 font-semibold uppercase">${item.genre}</span>
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // Render Top Lançamentos
        function renderReleases() {
            const container = document.getElementById('releasesGrid');
            container.innerHTML = '';

            releasesData.forEach(rel => {
                const card = document.createElement('div');
                card.className = 'bg-zinc-900 border border-zinc-800 rounded-3xl overflow-hidden flex flex-col justify-between group hover:border-purple-500/50 transition shadow-xl';
                card.innerHTML = `
                    <div class="relative h-64 overflow-hidden">
                        <img src="${rel.image}" alt="${rel.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        <div class="absolute top-4 left-4 bg-black/70 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-rose-400 border border-rose-500/30 flex items-center gap-1.5">
                            <i data-lucide="flame" class="w-3.5 h-3.5"></i> ${rel.date}
                        </div>
                    </div>
                    <div class="p-6 space-y-4">
                        <div class="space-y-1">
                            <span class="text-xs font-bold text-purple-400 uppercase tracking-widest">${rel.type}</span>
                            <h3 class="text-xl font-bold text-white">${rel.title}</h3>
                            <p class="text-sm text-zinc-400 font-semibold">por <span class="text-white hover:underline cursor-pointer" onclick="openArtistPage('${rel.artist}')">${rel.artist}</span></p>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-zinc-800 text-xs text-zinc-400">
                            <span class="flex items-center gap-1 font-medium text-zinc-300"><i data-lucide="headphones" class="w-4 h-4 text-purple-400"></i> ${rel.streams}</span>
                            <button onclick="alert('Redirecionando para a plataforma oficial de streaming.')" class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold transition shadow-md">
                                ${rel.linkText}
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // Switch Views
        function switchView(viewName) {
            document.getElementById('view-feed').classList.add('hidden');
            document.getElementById('view-releases').classList.add('hidden');
            document.getElementById('view-artist').classList.add('hidden');

            document.getElementById('nav-feed').className = 'px-4 py-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all';
            document.getElementById('nav-releases').className = 'px-4 py-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all';
            document.getElementById('nav-artists').className = 'px-4 py-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all';

            if (viewName === 'feed') {
                document.getElementById('view-feed').classList.remove('hidden');
                document.getElementById('nav-feed').className = 'px-4 py-2 rounded-full bg-zinc-800 text-white transition-all shadow-sm';
                renderFeed(mediaAcervo);
            } else if (viewName === 'releases') {
                document.getElementById('view-releases').classList.remove('hidden');
                document.getElementById('nav-releases').className = 'px-4 py-2 rounded-full bg-zinc-800 text-white transition-all shadow-sm';
            } else if (viewName === 'artists') {
                openArtistPage('The Weeknd');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Open Dedicated Artist Page (.html like view)
        function openArtistPage(artistName) {
            const item = mediaAcervo.find(m => m.artist === artistName) || mediaAcervo[0];

            document.getElementById('artistBanner').src = item.banner;
            document.getElementById('artistAvatar').src = item.avatar;
            document.getElementById('artistName').innerText = item.artist;
            document.getElementById('artistGenre').innerText = `Gênero: ${item.genre} • Acervo Oficial`;
            document.getElementById('artistBio').innerText = item.bio;

            const artistItems = mediaAcervo.filter(m => m.artist === item.artist);
            renderFeed(artistItems, 'artistMasonryGrid');

            document.getElementById('view-feed').classList.add('hidden');
            document.getElementById('view-releases').classList.add('hidden');
            document.getElementById('view-artist').classList.remove('hidden');

            document.getElementById('nav-artists').className = 'px-4 py-2 rounded-full bg-zinc-800 text-white transition-all shadow-sm';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            lucide.createIcons();
        }

        // Filter Categories
        function filterCategory(cat) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = 'category-btn px-4 py-2 rounded-full text-xs font-semibold bg-zinc-900 text-zinc-300 hover:bg-zinc-800 hover:text-white transition flex-shrink-0 border border-zinc-800';
            });
            event.target.className = 'category-btn px-4 py-2 rounded-full text-xs font-semibold bg-white text-black transition flex-shrink-0 shadow-md';

            if (cat === 'all') {
                renderFeed(mediaAcervo);
            } else {
                const filtered = mediaAcervo.filter(m => m.type === cat);
                renderFeed(filtered);
            }
        }

        // Artist Tab Filter
        function switchArtistTab(tab) {
            document.getElementById('art-tab-all').className = 'text-zinc-400 hover:text-white pb-3 transition';
            document.getElementById('art-tab-capa').className = 'text-zinc-400 hover:text-white pb-3 transition';
            document.getElementById('art-tab-foto').className = 'text-zinc-400 hover:text-white pb-3 transition';
            document.getElementById('art-tab-gif').className = 'text-zinc-400 hover:text-white pb-3 transition';

            document.getElementById(`art-tab-${tab}`).className = 'text-white pb-3 border-b-2 border-purple-500 -mb-3 transition';

            const currentArtist = document.getElementById('artistName').innerText;
            const artistItems = mediaAcervo.filter(m => m.artist === currentArtist);

            if (tab === 'all') {
                renderFeed(artistItems, 'artistMasonryGrid');
            } else {
                const filtered = artistItems.filter(m => m.type === tab);
                renderFeed(filtered, 'artistMasonryGrid');
            }
        }

        // Modal View
        function openModal(item) {
            currentMedia = item;
            document.getElementById('modalImage').src = item.image;
            document.getElementById('modalAvatar').src = item.avatar;
            document.getElementById('modalArtist').innerText = item.artist;
            document.getElementById('modalCategory').innerText = `Acervo • ${item.type.toUpperCase()}`;
            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalDesc').innerText = item.desc;

            const tagsContainer = document.getElementById('modalTags');
            tagsContainer.innerHTML = '';
            item.tags.forEach(tag => {
                const t = document.createElement('span');
                t.className = 'px-3 py-1 bg-zinc-800/80 text-purple-300 text-xs rounded-full font-medium border border-zinc-700/60';
                t.innerText = `#${tag}`;
                tagsContainer.appendChild(t);
            });

            document.getElementById('mediaModal').classList.remove('hidden');
            document.getElementById('mediaModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('mediaModal').classList.add('hidden');
            document.getElementById('mediaModal').classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        // Live Search
        document.getElementById('searchInput').addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const filtered = mediaAcervo.filter(m => 
                m.title.toLowerCase().includes(query) || 
                m.artist.toLowerCase().includes(query) || 
                m.genre.toLowerCase().includes(query) ||
                m.tags.some(t => t.toLowerCase().includes(query))
            );
            renderFeed(filtered);
            switchView('feed');
        });
    </script>
</body>
</html>

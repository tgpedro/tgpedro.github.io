<title>Marvel — Maratona Definitiva</title>
<style>
  :root{
    --bg:#000;
    --card:#111;
    --card2:#171717;
    --text:#f5f5f7;
    --muted:#a1a1a6;
    --line:#2a2a2a;
    --accent:#0a84ff;
    --green:#30d158;
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1050px;margin:auto;padding:48px 22px 80px}
  header{text-align:center;margin-bottom:38px}
  .eyebrow{font-size:13px;color:var(--accent);font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  h1{font-size:clamp(42px,7vw,76px);letter-spacing:-.055em;line-height:.98;margin:12px 0 16px;font-weight:750}
  .subtitle{max-width:700px;margin:auto;color:var(--muted);font-size:18px;line-height:1.5}
  .progressBox{
    margin:34px 0 24px;padding:22px;border:1px solid var(--line);border-radius:24px;
    background:linear-gradient(180deg,#121212,#090909);box-shadow:0 20px 60px rgba(0,0,0,.35)
  }
  .progressTop{display:flex;justify-content:space-between;gap:15px;align-items:end;margin-bottom:12px}
  .progressTop strong{font-size:18px}
  #count{color:var(--muted);font-size:14px}
  .bar{height:7px;background:#252525;border-radius:999px;overflow:hidden}
  #barFill{height:100%;width:0;background:var(--accent);border-radius:999px;transition:.25s}
  .tools{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 28px}
  input,button{
    font:inherit;border:1px solid var(--line);background:#121212;color:var(--text);
    border-radius:14px;padding:12px 15px;outline:none
  }
  input{flex:1;min-width:220px}
  button{cursor:pointer}
  button:hover{background:#1d1d1d}
  .section{
    margin:38px 0 16px;padding-top:8px;border-top:1px solid #202020
  }
  .section h2{font-size:27px;letter-spacing:-.025em;margin:0 0 7px}
  .section p{color:var(--muted);margin:0 0 15px;font-size:14px}
  .item{
    display:grid;grid-template-columns:52px 1fr 145px;gap:14px;align-items:center;
    padding:14px 0;border-bottom:1px solid #171717
  }
  .num{color:#555;font-variant-numeric:tabular-nums;font-size:13px;text-align:center}
  .title{font-size:16px;font-weight:600;line-height:1.3}
  .meta{font-size:12px;color:#777;margin-top:4px}
  select{
    width:145px;background:#121212;color:#f5f5f7;border:1px solid #292929;
    border-radius:12px;padding:10px 9px;font:inherit;font-size:13px
  }
  .item.watched .title{text-decoration:line-through;color:#777}
  .item.watched .num{color:var(--green)}
  .item.watched select{border-color:#285c37}
  .badge{
    display:inline-block;padding:4px 8px;border-radius:999px;background:#1c1c1e;
    color:#aaa;font-size:11px;margin-left:6px
  }
  footer{color:#666;text-align:center;font-size:13px;margin-top:55px;line-height:1.6}
  @media(max-width:650px){
    .wrap{padding:32px 16px 60px}
    .item{grid-template-columns:32px 1fr;gap:10px}
    select{grid-column:2;width:100%}
    .num{text-align:left}
  }
</style>
</head>

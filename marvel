const KEY="marvel-marathon-v1";
let state=JSON.parse(localStorage.getItem(KEY)||"{}");
let filter="all";

function flatItems(){
  return sections.flatMap((s,si)=>s.items.map((x,ii)=>({si,ii,title:x[0],meta:x[1],id:`${si}-${ii}`})));
}
function save(){localStorage.setItem(KEY,JSON.stringify(state));}
function updateProgress(){
  const all=flatItems(), watched=all.filter(x=>state[x.id]==="watched").length;
  const pct=all.length?Math.round(watched/all.length*100):0;
  document.getElementById("progressText").textContent=`${pct}% concluído`;
  document.getElementById("count").textContent=`${watched} de ${all.length} vistos`;
  document.getElementById("barFill").style.width=pct+"%";
}
function render(){
  const root=document.getElementById("list");
  const q=document.getElementById("search").value.trim().toLowerCase();
  root.innerHTML="";
  let global=0;
  sections.forEach((sec,si)=>{
    const secEl=document.createElement("section");
    secEl.className="section";
    let visible=0;
    const content=document.createDocumentFragment();
    sec.items.forEach((x,ii)=>{
      global++;
      const id=`${si}-${ii}`;
      const status=state[id]||"unwatched";
      const hay=(x[0]+" "+x[1]).toLowerCase();
      if(q && !hay.includes(q)) return;
      if(filter==="watched" && status!=="watched") return;
      if(filter==="unwatched" && status==="watched") return;
      visible++;
      const item=document.createElement("div");
      item.className="item"+(status==="watched"?" watched":"");
      item.innerHTML=`
        <div class="num">${global}</div>
        <div>
          <div class="title">${escapeHtml(x[0])}</div>
          <div class="meta">${escapeHtml(x[1])}</div>
        </div>
        <select aria-label="Status de ${escapeHtml(x[0])}" data-id="${id}">
          <option value="unwatched" ${status==="unwatched"?"selected":""}>Não vi</option>
          <option value="watched" ${status==="watched"?"selected":""}>✓ Já vi</option>
        </select>`;
      content.appendChild(item);
    });
    if(visible){
      secEl.innerHTML=`<h2>${sec.title}</h2><p>${sec.desc}</p>`;
      secEl.appendChild(content);
      root.appendChild(secEl);
    }
  });
  document.querySelectorAll("select[data-id]").forEach(sel=>{
    sel.addEventListener("change",e=>{
      state[e.target.dataset.id]=e.target.value;
      save(); render(); updateProgress();
    });
  });
  updateProgress();
}
function escapeHtml(s){
  return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));
}
function showOnly(v){filter=v;render();}
function resetAll(){
  if(confirm("Apagar todo o seu progresso?")){
    state={};save();render();
  }
}
document.getElementById("search").addEventListener("input",render);
render();

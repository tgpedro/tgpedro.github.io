<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CineLocal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b0b0c;
    --bg-elev:#19161a;
    --bg-elev-2:#221d21;
    --curtain:#7a1128;
    --curtain-bright:#a3193a;
    --gold:#d4a93b;
    --gold-dim:#8a742f;
    --text:#f3ede4;
    --text-dim:#b3aa9d;
    --text-faint:#77706a;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',system-ui,sans-serif;
    min-height:100vh;
    overflow-x:hidden;
  }
  ::selection{background:var(--curtain);color:var(--text);}
  a,button{font-family:inherit;}
  :focus-visible{outline:2px solid var(--gold);outline-offset:2px;}

  /* ---------- header ---------- */
  header{
    position:sticky;top:0;z-index:20;
    background:linear-gradient(180deg,rgba(11,11,12,.97),rgba(11,11,12,.9));
    backdrop-filter:blur(6px);
    border-bottom:1px solid #26212380;
  }
  .marquee-lights{
    height:4px;width:100%;
    background:repeating-linear-gradient(90deg,var(--gold) 0 3px, transparent 3px 12px);
    background-size:200% 100%;
    animation:chase 3.5s linear infinite;
    opacity:.55;
  }
  @keyframes chase{ to{ background-position:-24px 0; } }
  .headerbar{
    display:flex;align-items:center;gap:20px;
    padding:14px 28px;max-width:1400px;margin:0 auto;
  }
  .brand{
    font-family:'Oswald',sans-serif;
    font-weight:700;
    letter-spacing:.14em;
    font-size:22px;
    color:var(--text);
    white-space:nowrap;
    text-transform:uppercase;
  }
  .brand span{color:var(--curtain-bright);}
  .search-wrap{flex:1;max-width:420px;position:relative;}
  .search-wrap input{
    width:100%;padding:9px 14px 9px 34px;
    background:var(--bg-elev);border:1px solid #332c30;border-radius:999px;
    color:var(--text);font-size:14px;
  }
  .search-wrap input::placeholder{color:var(--text-faint);}
  .search-wrap svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);opacity:.5;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    background:var(--curtain);color:var(--text);border:none;
    padding:10px 18px;border-radius:999px;font-weight:600;font-size:14px;
    cursor:pointer;transition:background .15s, transform .1s;
    white-space:nowrap;
  }
  .btn:hover{background:var(--curtain-bright);}
  .btn:active{transform:scale(.97);}
  .btn.ghost{background:transparent;border:1px solid #443a3f;color:var(--text-dim);}
  .btn.ghost:hover{border-color:var(--gold-dim);color:var(--text);}

  /* ---------- main / rows ---------- */
  main{max-width:1400px;margin:0 auto;padding:28px 28px 80px;min-height:60vh;}
  .row{margin-bottom:38px;}
  .row h2{
    font-family:'Oswald',sans-serif;font-weight:500;letter-spacing:.03em;
    font-size:19px;margin:0 0 14px 2px;color:var(--text);
    display:flex;align-items:center;gap:10px;
  }
  .row h2::after{content:"";flex:1;height:1px;background:#2a2427;}
  .track{
    display:flex;gap:14px;overflow-x:auto;padding:6px 2px 14px;
    scroll-snap-type:x proximity;
  }
  .track::-webkit-scrollbar{height:8px;}
  .track::-webkit-scrollbar-thumb{background:#332c30;border-radius:4px;}
  .track::-webkit-scrollbar-track{background:transparent;}

  .card{
    position:relative;flex:0 0 auto;width:250px;scroll-snap-align:start;
    border-radius:var(--radius);overflow:hidden;cursor:pointer;
    background:var(--bg-elev);
    transition:transform .18s ease;
  }
  .card:hover, .card:focus-visible{transform:translateY(-4px) scale(1.02);}
  .card .thumb{
    width:100%;aspect-ratio:16/9;object-fit:cover;display:block;
    background:linear-gradient(135deg,var(--bg-elev),var(--bg-elev-2));
  }
  .card .thumb.placeholder{display:flex;align-items:center;justify-content:center;color:var(--text-faint);}
  .card .glow-border{
    position:absolute;inset:0;border-radius:var(--radius);pointer-events:none;
    padding:2px;opacity:0;transition:opacity .2s;
    background:conic-gradient(from var(--ang,0deg), var(--gold), transparent 24%, transparent 76%, var(--gold));
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;mask-composite:exclude;
  }
  .card:hover .glow-border, .card:focus-visible .glow-border{opacity:1;animation:spin 2.4s linear infinite;}
  @keyframes spin{ to{ --ang:360deg; } }
  @property --ang{ syntax:'<angle>'; inherits:false; initial-value:0deg; }

  .card .meta{padding:10px 11px 12px;}
  .card .title{
    font-size:13.5px;font-weight:600;line-height:1.3;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  }
  .card .sub{font-size:11.5px;color:var(--text-faint);margin-top:3px;}
  .badge{
    position:absolute;top:8px;right:8px;background:rgba(0,0,0,.65);
    color:var(--gold);font-size:10.5px;font-weight:600;padding:2px 7px;border-radius:5px;
    backdrop-filter:blur(2px);
  }
  .progress{
    position:absolute;left:0;bottom:0;height:3px;background:var(--gold);
    box-shadow:0 0 6px var(--gold);
  }

  /* ---------- empty states ---------- */
  .empty{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:90px 20px;color:var(--text-dim);gap:14px;
  }
  .empty h1{font-family:'Oswald',sans-serif;font-size:26px;color:var(--text);margin:0;font-weight:500;}
  .empty p{max-width:440px;margin:0;font-size:14.5px;line-height:1.5;color:var(--text-faint);}

  /* ---------- player modal ---------- */
  .modal{
    position:fixed;inset:0;background:#000;z-index:100;
    display:none;flex-direction:column;
  }
  .modal.open{display:flex;}
  .modal-top{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 22px;background:linear-gradient(180deg,rgba(0,0,0,.85),transparent);
    position:absolute;top:0;left:0;right:0;z-index:2;
  }
  .modal-top h3{font-family:'Oswald',sans-serif;font-weight:500;font-size:17px;margin:0;color:var(--text);}
  .close-btn{
    background:rgba(255,255,255,.08);border:none;color:var(--text);
    width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:18px;
    display:flex;align-items:center;justify-content:center;
  }
  .close-btn:hover{background:rgba(255,255,255,.18);}
  .modal video{width:100%;height:100%;object-fit:contain;background:#000;}

  .hint{font-size:12px;color:var(--text-faint);margin-top:2px;}

  @media (max-width:640px){
    .headerbar{padding:12px 16px;gap:10px;}
    .brand{font-size:17px;}
    main{padding:20px 16px 60px;}
    .card{width:180px;}
  }
</style>
</head>
<body>

<header>
  <div class="marquee-lights"></div>
  <div class="headerbar">
    <div class="brand">CINE<span>LOCAL</span></div>
    <div class="search-wrap">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-3.5-3.5"/></svg>
      <input id="search" type="search" placeholder="Buscar na sua biblioteca..." disabled>
    </div>
    <button class="btn" id="openBtn">Abrir pasta</button>
    <input type="file" id="fallbackInput" webkitdirectory multiple style="display:none">
  </div>
</header>

<main id="main">
  <div class="empty" id="emptyState">
    <h1>Sua biblioteca está vazia</h1>
    <p>Clique em <strong>Abrir pasta</strong> e selecione a pasta onde ficam seus vídeos extraídos (ex: pasta de downloads do uTorrent). O CineLocal organiza tudo automaticamente, sem enviar nenhum arquivo para fora do seu computador.</p>
  </div>
</main>

<div class="modal" id="modal">
  <div class="modal-top">
    <h3 id="modalTitle"></h3>
    <button class="close-btn" id="closeBtn" aria-label="Fechar">✕</button>
  </div>
  <video id="player" controls autoplay></video>
</div>

<script>
(() => {
'use strict';

const VIDEO_EXT = ['mp4','webm','ogg','ogv','mov','mkv','avi','wmv','flv','m4v','ts','m2ts','3gp'];
const SUB_EXT = ['vtt','srt'];
const hasFS = ('showDirectoryPicker' in window) && location.protocol !== 'file:';

const emptyState = document.getElementById('emptyState');
const mainEl = document.getElementById('main');
const searchInput = document.getElementById('search');
const openBtn = document.getElementById('openBtn');
const fallbackInput = document.getElementById('fallbackInput');
const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const closeBtn = document.getElementById('closeBtn');
const player = document.getElementById('player');

let library = [];        // flat list of entry objects
let currentEntry = null;
let saveTimer = null;

// ---------- tiny IndexedDB helper (only used when File System Access API is available) ----------
function idbOpen(){
  return new Promise((resolve, reject) => {
    const req = indexedDB.open('cinelocal-db', 1);
    req.onupgradeneeded = () => req.result.createObjectStore('handles');
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}
async function idbGet(key){
  const db = await idbOpen();
  return new Promise((resolve, reject) => {
    const tx = db.transaction('handles', 'readonly');
    const r = tx.objectStore('handles').get(key);
    r.onsuccess = () => resolve(r.result || null);
    r.onerror = () => reject(r.error);
  });
}
async function idbSet(key, val){
  const db = await idbOpen();
  return new Promise((resolve, reject) => {
    const tx = db.transaction('handles', 'readwrite');
    tx.objectStore('handles').put(val, key);
    tx.oncomplete = () => resolve();
    tx.onerror = () => reject(tx.error);
  });
}

// ---------- filename cleanup ----------
function cleanTitle(name){
  let n = name.replace(/\.[^.]+$/, '');
  n = n.replace(/[\._]+/g, ' ');
  n = n.replace(/\[(.*?)\]|\((.*?)\)/g, ' ');
  n = n.replace(/\b(1080p|720p|2160p|4k|hdrip|webrip|web-dl|bluray|brrip|x264|x265|h264|h265|dublado|legendado|dual audio|yify|rarbg)\b/gi, ' ');
  n = n.replace(/\s{2,}/g, ' ').trim();
  return n || name;
}

function extOf(name){ return name.split('.').pop().toLowerCase(); }
function baseOf(name){ const e = extOf(name); return name.slice(0, name.length - e.length - 1); }

// ---------- scanning: File System Access API ----------
async function walkFS(dirHandle, path, videos, subs){
  for await (const [name, handle] of dirHandle.entries()){
    if (handle.kind === 'directory'){
      await walkFS(handle, path + name + '/', videos, subs);
    } else {
      const ext = extOf(name);
      if (VIDEO_EXT.includes(ext)){
        videos.push({ handle, name, dirPath: path, folder: path.split('/').filter(Boolean)[0] || 'Avulsos' });
      } else if (SUB_EXT.includes(ext)){
        subs[path + baseOf(name)] = { handle, ext };
      }
    }
  }
}

async function scanFSHandle(dirHandle){
  const videos = [];
  const subs = {};
  await walkFS(dirHandle, '', videos, subs);
  return videos.map(v => {
    const key = v.dirPath + baseOf(v.name);
    return {
      name: v.name,
      folder: v.folder,
      title: cleanTitle(v.name),
      getFile: () => v.handle.getFile(),
      subtitle: subs[key] ? { getFile: () => subs[key].handle.getFile(), ext: subs[key].ext } : null,
      thumb: null,
      duration: null
    };
  });
}

// ---------- scanning: fallback <input webkitdirectory> ----------
function scanFileList(fileList){
  const files = Array.from(fileList);
  const byKey = {};
  const videos = [];
  const subs = {};
  files.forEach(f => {
    const rel = f.webkitRelativePath || f.name;
    const parts = rel.split('/');
    const ext = extOf(f.name);
    const dirPath = parts.slice(1, -1).join('/'); // drop root folder name
    const folder = parts.length > 2 ? parts[1] : 'Avulsos';
    if (VIDEO_EXT.includes(ext)){
      videos.push({ file: f, name: f.name, folder, dirPath });
    } else if (SUB_EXT.includes(ext)){
      subs[dirPath + '/' + baseOf(f.name)] = { file: f, ext };
    }
  });
  return videos.map(v => {
    const key = v.dirPath + '/' + baseOf(v.name);
    return {
      name: v.name,
      folder: v.folder,
      title: cleanTitle(v.name),
      getFile: async () => v.file,
      subtitle: subs[key] ? { getFile: async () => subs[key].file, ext: subs[key].ext } : null,
      thumb: null,
      duration: null
    };
  });
}

// ---------- rendering ----------
function progressKeyFor(entry, size){
  return 'cinelocal:progress:' + entry.folder + '/' + entry.name + ':' + size;
}
function readProgress(entry, size){
  try { return JSON.parse(localStorage.getItem(progressKeyFor(entry, size)) || 'null'); }
  catch(e){ return null; }
}

function formatDuration(sec){
  if (!sec || !isFinite(sec)) return '';
  const m = Math.floor(sec / 60), s = Math.floor(sec % 60);
  const h = Math.floor(m / 60);
  if (h > 0) return `${h}h ${m % 60}min`;
  return `${m}min`;
}

function makeCard(entry){
  const card = document.createElement('div');
  card.className = 'card';
  card.tabIndex = 0;

  const thumb = document.createElement('div');
  thumb.className = 'thumb placeholder';
  thumb.textContent = '🎬';
  card.appendChild(thumb);

  const glow = document.createElement('div');
  glow.className = 'glow-border';
  card.appendChild(glow);

  if (entry._badge) {
    const badge = document.createElement('div');
    badge.className = 'badge';
    badge.textContent = entry._badge;
    card.appendChild(badge);
  }

  const meta = document.createElement('div');
  meta.className = 'meta';
  const title = document.createElement('div');
  title.className = 'title';
  title.textContent = entry.title;
  meta.appendChild(title);
  const sub = document.createElement('div');
  sub.className = 'sub';
  sub.textContent = entry.folder;
  meta.appendChild(sub);
  card.appendChild(meta);

  const open = () => openPlayer(entry);
  card.addEventListener('click', open);
  card.addEventListener('keydown', e => { if (e.key === 'Enter') open(); });

  // lazy thumbnail generation
  const io = new IntersectionObserver(async entries => {
    if (entries[0].isIntersecting){
      io.disconnect();
      await ensureThumbnail(entry);
      if (entry.thumb){
        thumb.classList.remove('placeholder');
        thumb.textContent = '';
        const img = document.createElement('img');
        img.className = 'thumb';
        img.src = entry.thumb;
        card.replaceChild(img, thumb);
      }
      if (entry.duration){
        const b = document.createElement('div');
        b.className = 'badge';
        b.textContent = formatDuration(entry.duration);
        card.appendChild(b);
      }
    }
  }, { rootMargin: '400px' });
  io.observe(card);

  return card;
}

async function ensureThumbnail(entry){
  if (entry.thumb || entry._thumbFailed) return;
  try {
    const file = await entry.getFile();
    const url = URL.createObjectURL(file);
    await new Promise((resolve) => {
      const v = document.createElement('video');
      v.muted = true; v.playsInline = true; v.preload = 'metadata';
      v.src = url;
      let done = false;
      const finish = () => { if (!done){ done = true; resolve(); } };
      v.addEventListener('loadedmetadata', () => {
        entry.duration = v.duration;
        v.currentTime = Math.min(Math.max(v.duration * 0.12, 1), v.duration - 0.5 || 1);
      });
      v.addEventListener('seeked', () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = 320; canvas.height = 180;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(v, 0, 0, canvas.width, canvas.height);
          entry.thumb = canvas.toDataURL('image/jpeg', 0.7);
        } catch(e){ entry._thumbFailed = true; }
        URL.revokeObjectURL(url);
        finish();
      });
      v.addEventListener('error', () => { entry._thumbFailed = true; URL.revokeObjectURL(url); finish(); });
      setTimeout(finish, 6000); // safety timeout
    });
  } catch(e){ entry._thumbFailed = true; }
}

function renderLibrary(){
  emptyState.style.display = 'none';
  searchInput.disabled = false;
  render();
}

function render(){
  mainEl.querySelectorAll('.row').forEach(r => r.remove());
  const q = searchInput.value.trim().toLowerCase();

  if (q){
    const results = library.filter(e => e.title.toLowerCase().includes(q));
    mainEl.appendChild(buildRow('Resultados para "' + searchInput.value + '"', results));
    return;
  }

  // continue watching
  const continuing = library.filter(e => {
    const p = e._lastProgress;
    return p && p.time > 20 && p.duration && p.time < p.duration * 0.95;
  });
  if (continuing.length){
    const row = buildRow('Continuar assistindo', continuing);
    row.dataset.priority = '1';
    mainEl.appendChild(row);
  }

  // group by folder, preserving first-seen order
  const groups = {};
  const order = [];
  library.forEach(e => {
    if (!groups[e.folder]){ groups[e.folder] = []; order.push(e.folder); }
    groups[e.folder].push(e);
  });
  order.forEach(folder => {
    mainEl.appendChild(buildRow(folder, groups[folder]));
  });

  if (!library.length){
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = '<h1>Nenhum vídeo encontrado</h1><p>Essa pasta não parece ter arquivos de vídeo suportados.</p>';
    mainEl.appendChild(empty);
  }
}

function buildRow(title, entries){
  const row = document.createElement('div');
  row.className = 'row';
  const h2 = document.createElement('h2');
  h2.textContent = title;
  row.appendChild(h2);
  const track = document.createElement('div');
  track.className = 'track';
  entries.forEach(e => track.appendChild(makeCard(e)));
  row.appendChild(track);
  return row;
}

// ---------- player ----------
function srtToVtt(text){
  let out = text.replace(/\r+/g, '');
  out = out.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2');
  return 'WEBVTT\n\n' + out;
}

async function openPlayer(entry){
  currentEntry = entry;
  const file = await entry.getFile();
  const url = URL.createObjectURL(file);
  modalTitle.textContent = entry.title;

  // clear old tracks
  player.querySelectorAll('track').forEach(t => t.remove());
  player.src = url;

  const progress = readProgress(entry, file.size);
  player.addEventListener('loadedmetadata', function onMeta(){
    player.removeEventListener('loadedmetadata', onMeta);
    if (progress && progress.time < player.duration * 0.97){
      player.currentTime = progress.time;
    }
  });

  if (entry.subtitle){
    try {
      const subFile = await entry.subtitle.getFile();
      let vttText;
      if (entry.subtitle.ext === 'srt'){
        vttText = srtToVtt(await subFile.text());
      } else {
        vttText = await subFile.text();
      }
      const vttUrl = URL.createObjectURL(new Blob([vttText], { type: 'text/vtt' }));
      const track = document.createElement('track');
      track.kind = 'subtitles';
      track.label = 'Legenda';
      track.srclang = 'pt';
      track.src = vttUrl;
      track.default = true;
      player.appendChild(track);
    } catch(e){ /* subtitle optional, ignore failures */ }
  }

  modal.classList.add('open');
  document.body.style.overflow = 'hidden';

  clearInterval(saveTimer);
  saveTimer = setInterval(() => saveProgress(entry, file.size), 4000);
}

function saveProgress(entry, size){
  if (!player.duration) return;
  const data = { time: player.currentTime, duration: player.duration, updatedAt: Date.now() };
  entry._lastProgress = data;
  try { localStorage.setItem(progressKeyFor(entry, size), JSON.stringify(data)); } catch(e){}
}

function closePlayer(){
  if (currentEntry && player.src){
    entryFileSizeThenSave();
  }
  clearInterval(saveTimer);
  player.pause();
  const oldSrc = player.src;
  player.removeAttribute('src');
  player.load();
  if (oldSrc) URL.revokeObjectURL(oldSrc);
  modal.classList.remove('open');
  document.body.style.overflow = '';
  currentEntry = null;
  render();
}
async function entryFileSizeThenSave(){
  try {
    const f = await currentEntry.getFile();
    saveProgress(currentEntry, f.size);
  } catch(e){}
}

closeBtn.addEventListener('click', closePlayer);
document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.classList.contains('open')) closePlayer(); });

// ---------- opening a folder ----------
async function scanAndRender(entries){
  library = entries;
  renderLibrary();
}

openBtn.addEventListener('click', async () => {
  if (hasFS){
    try {
      const dirHandle = await window.showDirectoryPicker();
      idbSet('lastDir', dirHandle).catch(()=>{});
      openBtn.textContent = 'Lendo pasta...';
      const entries = await scanFSHandle(dirHandle);
      openBtn.textContent = 'Abrir pasta';
      scanAndRender(entries);
    } catch(e){
      if (e.name !== 'AbortError') console.error(e);
    }
  } else {
    fallbackInput.click();
  }
});

fallbackInput.addEventListener('change', () => {
  if (!fallbackInput.files.length) return;
  const entries = scanFileList(fallbackInput.files);
  scanAndRender(entries);
});

searchInput.addEventListener('input', () => render());

// try to restore last-used folder (only possible with File System Access API)
(async () => {
  if (!hasFS) return;
  try {
    const dirHandle = await idbGet('lastDir');
    if (!dirHandle) return;
    const perm = await dirHandle.queryPermission({ mode: 'read' });
    if (perm === 'granted'){
      const entries = await scanFSHandle(dirHandle);
      scanAndRender(entries);
    } else {
      openBtn.textContent = 'Reabrir "' + dirHandle.name + '"';
      openBtn.onclick = async () => {
        const p = await dirHandle.requestPermission({ mode: 'read' });
        if (p === 'granted'){
          const entries = await scanFSHandle(dirHandle);
          scanAndRender(entries);
          openBtn.textContent = 'Abrir pasta';
          openBtn.onclick = null;
          openBtn.addEventListener('click', () => {}); // no-op, main handler still bound below
          location.reload(); // simplest way to restore normal click handler cleanly
        }
      };
    }
  } catch(e){ /* ignore */ }
})();

})();
</script>
</body>
</html>
